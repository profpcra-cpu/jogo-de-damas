        // ============================================================
        // =============== RENDERIZAÇÃO DAS REGRAS ====================
        // ============================================================
        function renderizarReguas() {
            const invertido = (minhaCor === 'red');
            const colunas = ['a','b','c','d','e','f','g','h'];
            const linhas = ['8','7','6','5','4','3','2','1'];

            const topo    = invertido ? linhas.slice().reverse() : linhas.slice();
            const base    = invertido ? linhas.slice()           : linhas.slice().reverse();
            const esquerda = invertido ? colunas.slice().reverse() : colunas.slice();
            const direita  = invertido ? colunas.slice()           : colunas.slice().reverse();

            const buildCols = (arr) => arr.map((v, i) => {
                const edge = (i === 0 || i === arr.length - 1) ? ' edge' : '';
                return `<div class="coord${edge}">${v}</div>`;
            }).join('');

            const buildRows = (arr) => arr.map((v, i) => {
                const edge = (i === 0 || i === arr.length - 1) ? ' edge' : '';
                return `<div class="coord${edge}">${v}</div>`;
            }).join('');

            const lt = document.getElementById('labels-top');
            const lb = document.getElementById('labels-bottom');
            const ll = document.getElementById('labels-left');
            const lr = document.getElementById('labels-right');

            if (lt) lt.innerHTML = buildCols(topo);
            if (lb) lb.innerHTML = buildCols(base);
            if (ll) ll.innerHTML = buildRows(esquerda);
            if (lr) lr.innerHTML = buildRows(direita);
        }

        function renderizarTabuleiro() {
            const grid = document.getElementById('checkers-board');
            if (!grid) return;
            grid.innerHTML = '';
            const invertido = (minhaCor === 'red');

            for (let vr = 0; vr < 8; vr++) {
                for (let vc = 0; vc < 8; vc++) {
                    const r = invertido ? (7 - vr) : vr;
                    const c = invertido ? (7 - vc) : vc;
                    const square = document.createElement('div');
                    const isDark = (r + c) % 2 === 1;
                    square.className = `square ${isDark ? 'dark' : 'light'}`;

                    if (celulaSelecionada?.r === r && celulaSelecionada?.c === c) square.classList.add('selected');
                    const mov = movimentosValidos.find(m => m.r === r && m.c === c);
                    if (mov) square.classList.add(mov.captura ? 'capture-target' : 'highlight');

                    const peca = tabuleiro[r]?.[c];
                    if (peca) {
                        const wrapper = document.createElement('div');
                        wrapper.className = 'piece-wrapper';
                        const pieceEl = document.createElement('div');
                        const corClasse = peca.startsWith('white') ? 'white' : 'red';
                        const isDama = peca.includes('king') ? ' king' : '';
                        pieceEl.className = `piece ${corClasse}${isDama}`;
                        wrapper.appendChild(pieceEl);
                        square.appendChild(wrapper);
                    }

                    if (isDark) square.addEventListener('click', () => clicarCasa(r, c));
                    grid.appendChild(square);
                }
            }

            renderizarReguas();

            document.getElementById('turno-status').textContent = jogoEncerrado ? '🏁 Fim' : (turnoAtual === minhaCor ? 'Sua vez!' : 'Vez do oponente...');

            // Mostra/esconde barra pós-jogo
            if (jogoEncerrado) {
                document.getElementById('div-pos-jogo')?.classList.remove('hidden');
            } else {
                document.getElementById('div-pos-jogo')?.classList.add('hidden');
            }
        }

        function clicarCasa(r, c) {
            if (jogoEncerrado || turnoAtual !== minhaCor) return;
            const peca = tabuleiro[r][c];

            if (capturaMultiplaEmAndamento) {
                if (movimentosValidos.some(m => m.r === r && m.c === c)) executarMovimento(celulaSelecionada.r, celulaSelecionada.c, r, c);
                return;
            }

            if (peca && peca.startsWith(minhaCor)) {
                SoundFX.select();
                celulaSelecionada = { r, c };
                movimentosValidos = calcularMovimentos(r, c);
                renderizarTabuleiro();
                return;
            }

            if (celulaSelecionada && movimentosValidos.some(m => m.r === r && m.c === c)) {
                executarMovimento(celulaSelecionada.r, celulaSelecionada.c, r, c);
                return;
            }

            SoundFX.click();
            celulaSelecionada = null;
            movimentosValidos = [];
            renderizarTabuleiro();
        }

        function calcularMovimentos(r, c) {
            const peca = tabuleiro[r][c];
            if (!peca) return [];
            const isDama = peca.includes('king');
            const cor = peca.startsWith('white') ? 'white' : 'red';
            const movimentos = [];

            if (isDama) {
                for (const dr of [-1, +1]) for (const dc of [-1, +1]) {
                    let nr = r + dr, nc = c + dc, capturada = null;
                    while (nr >= 0 && nr < 8 && nc >= 0 && nc < 8) {
                        const alvo = tabuleiro[nr][nc];
                        if (!alvo) {
                            if (!capturada) movimentos.push({ r: nr, c: nc });
                            else { movimentos.push({ r: nr, c: nc, captura: capturada }); break; }
                        } else if (alvo.startsWith(cor)) break;
                        else {
                            if (capturada) break;
                            capturada = { r: nr, c: nc };
                        }
                        nr += dr; nc += dc;
                    }
                }
            } else {
                const direcoesFrente = cor === 'white' ? [-1] : [+1];
                for (const dr of direcoesFrente) for (const dc of [-1, +1]) {
                    const nr = r + dr, nc = c + dc;
                    if (nr >= 0 && nr < 8 && nc >= 0 && nc < 8 && !tabuleiro[nr][nc]) movimentos.push({ r: nr, c: nc });
                }
                for (const dr of [-1, +1]) for (const dc of [-1, +1]) {
                    const mr = r + dr, mc = c + dc;
                    const jr = r + 2 * dr, jc = c + 2 * dc;
                    if (jr >= 0 && jr < 8 && jc >= 0 && jc < 8) {
                        const meio = tabuleiro[mr][mc];
                        if (meio && !meio.startsWith(cor) && !tabuleiro[jr][jc]) movimentos.push({ r: jr, c: jc, captura: { r: mr, c: mc } });
                    }
                }
            }
            const capturas = movimentos.filter(m => m.captura);
            return capturas.length > 0 ? capturas : movimentos;
        }

        async function executarMovimento(deR, deC, paraR, paraC) {
            const mov = movimentosValidos.find(m => m.r === paraR && m.c === paraC);
            if (!mov) return;

            const pecaMovida = tabuleiro[deR][deC];
            tabuleiro[paraR][paraC] = pecaMovida;
            tabuleiro[deR][deC] = null;

            if (mov.captura) {
                tabuleiro[mov.captura.r][mov.captura.c] = null;
                SoundFX.capture();
            } else {
                SoundFX.move();
            }

            let promoveu = false;
            if (pecaMovida === 'white' && paraR === 0) { tabuleiro[paraR][paraC] = 'white-king'; promoveu = true; }
            if (pecaMovida === 'red' && paraR === 7) { tabuleiro[paraR][paraC] = 'red-king'; promoveu = true; }
            if (promoveu) {
                setTimeout(() => SoundFX.king(), 120);
                toast('♛ Dama promovida!', 'success');
            }

            turnoAtual = turnoAtual === 'white' ? 'red' : 'white';
            celulaSelecionada = null;
            movimentosValidos = [];
            renderizarTabuleiro();

            // Verifica fim de jogo por peças/movimentos
            const vencedorPorTabuleiro = verificarFimDeJogo();

            const payload = {
                tabuleiro: tabuleiroParaFirebase(tabuleiro),
                turno: turnoAtual,
                status: vencedorPorTabuleiro ? 'encerrado' : 'jogando'
            };
            if (vencedorPorTabuleiro) {
                payload.vencedor = vencedorPorTabuleiro;
                payload.motivoFim = 'sem-movimentos';
            }
            await update(ref(db, `salas_damas/${idSalaAtual}`), payload);
        }

        // Retorna 'white' | 'red' | null se o jogo terminou por falta de peças/movimentos
        function verificarFimDeJogo() {
            let temWhite = false, temRed = false;
            for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) {
                const p = tabuleiro[r][c];
                if (!p) continue;
                if (p.startsWith('white')) temWhite = true;
                if (p.startsWith('red')) temRed = true;
            }
            if (!temWhite) return 'red';
            if (!temRed) return 'white';

            const corDaVez = turnoAtual;
            for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) {
                const p = tabuleiro[r][c];
                if (p && p.startsWith(corDaVez)) {
                    if (calcularMovimentos(r, c).length > 0) return null;
                }
            }
            return corDaVez === 'white' ? 'red' : 'white';
        }

