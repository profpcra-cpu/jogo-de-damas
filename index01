        function resetarParaNovaPartida(dados) {
            desistenciaProcessada = false;
            pedidoRevancheDe = null;
            revancheAceita = false;
            celulaSelecionada = null;
            movimentosValidos = [];
            jogoEncerrado = false;
            vencedorDeclarado = null;
            tabuleiro = firebaseParaTabuleiro(dados.tabuleiro);
            turnoAtual = dados.turno || 'white';

            // Atualiza minha cor (pode ter sido trocada)
            const jogadores = dados.jogadores || {};
            if (jogadores[jogadorSessao.chave]?.cor) {
                minhaCor = jogadores[jogadorSessao.chave].cor;
                document.getElementById('info-minha-cor').textContent = minhaCor === 'white' ? '⚪ Brancas' : '🔴 Vermelhas';
            }

            document.getElementById('div-pos-jogo')?.classList.add('hidden');
            esconderPedidoRevanche();
            renderizarTabuleiro();
            SoundFX.notify();
            toast('🎮 Nova partida iniciada!', 'success');
        }

        function confirmarDesistencia() {
            SoundFX.click();
            abrirModal({
                icon: '🏳️',
                title: 'Desistir da partida?',
                message: 'Se você desistir, seu adversário será declarado vencedor.',
                actions: [
                    { label: 'Cancelar', onClick: () => {} },
                    {
                        label: 'Sim, desistir',
                        onClick: async () => {
                            try {
                                const corAdversaria = minhaCor === 'white' ? 'red' : 'white';
                                await update(ref(db, `salas_damas/${idSalaAtual}`), {
                                    status: 'encerrado',
                                    vencedor: corAdversaria,
                                    motivoFim: 'desistencia',
                                    desistente: jogadorSessao.chave
                                });
                            } catch (e) {
                                toast('Erro ao desistir.', 'error');
                            }
                        }
                    }
                ]
            });
        }

        // ============================================================
        // ============== ESCUTA FIREBASE (com revanche) ==============
        // ============================================================
        function escutarFirebase() {
            if (unsubscribeFirebase) unsubscribeFirebase();
            unsubscribeFirebase = onValue(ref(db, 'salas_damas/' + idSalaAtual), (snapshot) => {
                if (!snapshot.exists()) return;
                const dados = snapshot.val();
                const turnoAnterior = turnoAtual;
                const statusAnteriorEncerrado = jogoEncerrado;

                tabuleiro = firebaseParaTabuleiro(dados.tabuleiro);
                turnoAtual = dados.turno || 'white';
                jogoEncerrado = dados.status === 'encerrado';
                vencedorDeclarado = dados.vencedor || null;

                // Detecta desistência
                if (jogoEncerrado && dados.motivoFim === 'desistencia' && !desistenciaProcessada) {
                    desistenciaProcessada = true;
                    tratarFimDeJogo(vencedorDeclarado, 'desistencia');
                }

                // Detecta fim por tabuleiro
                if (jogoEncerrado && dados.motivoFim === 'sem-movimentos' && !desistenciaProcessada) {
                    desistenciaProcessada = true;
                    tratarFimDeJogo(vencedorDeclarado, 'sem-movimentos');
                }

                // Detecta pedido de revanche
                const pedido = dados.pedidoRevanche || null;
                if (pedido && pedido.de !== jogadorSessao.chave) {
                    if (pedidoRevancheDe !== pedido.de) {
                        pedidoRevancheDe = pedido.de;
                        SoundFX.notify();
                        mostrarPedidoRevanche(pedido.nome || 'Oponente');
                    }
                } else if (!pedido) {
                    pedidoRevancheDe = null;
                    esconderPedidoRevanche();
                }

                // Detecta reinício (revanche aceita)
                if (dados.status === 'jogando' && statusAnteriorEncerrado) {
                    resetarParaNovaPartida(dados);
                }

                // Atualiza minha cor caso tenha sido trocada
                const jogadores = dados.jogadores || {};
                if (jogadores[jogadorSessao.chave]?.cor) {
                    const novaCor = jogadores[jogadorSessao.chave].cor;
                    if (novaCor !== minhaCor) {
                        minhaCor = novaCor;
                        document.getElementById('info-minha-cor').textContent = minhaCor === 'white' ? '⚪ Brancas' : '🔴 Vermelhas';
                    }
                }

                // Som quando a vez passa para o jogador
                if (turnoAnterior !== turnoAtual && turnoAtual === minhaCor && !jogoEncerrado) {
                    setTimeout(() => SoundFX.notify(), 150);
                }

                renderizarTabuleiro();
            });
        }

        // ============================================================
        // ============== TELA CHEIA ==================================
        // ============================================================
        function isFullscreen() {
            return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
        }

        async function entrarTelaCheia() {
            const el = document.documentElement;
            try {
                if (el.requestFullscreen) await el.requestFullscreen({ navigationUI: 'hide' });
                else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
                else if (el.msRequestFullscreen) el.msRequestFullscreen();
                else { document.body.classList.add('is-fullscreen'); toast('Modo imersivo ativado (iOS).', 'info'); return; }
                document.body.classList.add('is-fullscreen');
                SoundFX.click();
            } catch (e) {
                document.body.classList.add('is-fullscreen');
            }
        }

        async function sairTelaCheia() {
            try {
                if (document.exitFullscreen) await document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                else if (document.msExitFullscreen) document.msExitFullscreen();
            } catch (_) {}
            document.body.classList.remove('is-fullscreen');
        }

        function alternarTelaCheia() {
            if (isFullscreen() || document.body.classList.contains('is-fullscreen')) sairTelaCheia();
            else entrarTelaCheia();
        }

        ['fullscreenchange', 'webkitfullscreenchange', 'msfullscreenchange'].forEach(evt => {
            document.addEventListener(evt, () => {
                if (isFullscreen()) document.body.classList.add('is-fullscreen');
                else if (!document.body.classList.contains('is-fullscreen')) document.body.classList.remove('is-fullscreen');
            });
        });

        document.getElementById('btn-fullscreen').addEventListener('click', alternarTelaCheia);
        document.getElementById('btn-fullscreen-game').addEventListener('click', alternarTelaCheia);
        document.getElementById('fs-exit').addEventListener('click', () => { SoundFX.click(); sairTelaCheia(); });

        // ============================================================
        // ============== SOM E TEMA ==================================
        // ============================================================
        const btnSom = document.getElementById('btn-som');
        const somPreferido = localStorage.getItem('brain_damas_som');
        if (somPreferido === 'off') {
            SoundFX.toggle();
            btnSom.textContent = '🔇';
        }
        btnSom.addEventListener('click', () => {
            const ativo = SoundFX.toggle();
            btnSom.textContent = ativo ? '🔊' : '🔇';
            localStorage.setItem('brain_damas_som', ativo ? 'on' : 'off');
        });

        const themeToggle = document.getElementById('theme-toggle');
        themeToggle.addEventListener('click', () => {
            SoundFX.click();
            const html = document.documentElement;
            const atual = html.getAttribute('data-theme');
            const novo = atual === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', novo);
            themeToggle.textContent = novo === 'dark' ? '🌙' : '☀️';
            localStorage.setItem('brain_damas_tema', novo);
        });

        const temaSalvo = localStorage.getItem('brain_damas_tema');
        if (temaSalvo) {
            document.documentElement.setAttribute('data-theme', temaSalvo);
            themeToggle.textContent = temaSalvo === 'dark' ? '🌙' : '☀️';
        }

        // ============================================================
        // ============== SAIR / DESISTIR / REVANCHE ==================
        // ============================================================
        document.getElementById('btn-sair').addEventListener('click', () => {
            SoundFX.click();
            abrirModal({
                icon: '🚪',
                title: 'Sair da partida?',
                message: 'Você pode perder o progresso da partida atual.',
                actions: [
                    { label: 'Cancelar', onClick: () => {} },
                    {
                        label: 'Sair',
                        onClick: async () => {
                            try {
                                if (idSalaAtual && jogadorSessao?.chave) {
                                    await update(ref(db, `salas_damas/${idSalaAtual}/jogadores/${jogadorSessao.chave}`), { online: false });
                                }
                            } catch (_) {}
                            limparSessao();
                            if (isFullscreen()) await sairTelaCheia();
                            window.location.href = window.location.pathname;
                        }
                    }
                ]
            });
        });

        document.getElementById('btn-desistir').addEventListener('click', confirmarDesistencia);

        document.getElementById('btn-jogar-novamente').addEventListener('click', enviarPedidoRevanche);

        document.getElementById('btn-sair-pos-jogo').addEventListener('click', () => {
            SoundFX.click();
            limparSessao();
            if (isFullscreen()) sairTelaCheia();
            window.location.href = window.location.pathname;
        });

        document.getElementById('btn-aceitar-revanche').addEventListener('click', aceitarRevanche);
        document.getElementById('btn-recusar-revanche').addEventListener('click', recusarRevanche);

        // Desbloqueia áudio no primeiro toque
        ['pointerdown', 'touchstart', 'keydown'].forEach(evt => {
            window.addEventListener(evt, () => SoundFX.click(), { once: true });
        });
    </script>
</body>
</html>
