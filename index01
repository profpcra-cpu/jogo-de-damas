<!DOCTYPE html>
<html lang="pt" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no, maximum-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0b1020">
    <title>Brain Damas - Duelo Multiplayer</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-color: #0b1020;
            --bg-gradient-1: #1e1b4b;
            --bg-gradient-2: #0b1020;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(148, 163, 184, 0.15);
            --card-glow: rgba(99, 102, 241, 0.25);
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --text-subtle: #64748b;
            --border-color: rgba(148, 163, 184, 0.18);
            --border-strong: rgba(148, 163, 184, 0.35);
            --input-bg: rgba(15, 23, 42, 0.7);
            --btn-primary: #6366f1;
            --btn-primary-hover: #818cf8;
            --btn-accent: #8b5cf6;
            --btn-whatsapp: #22c55e;
            --c-green: #4ade80;
            --c-blue: #38bdf8;
            --c-amber: #f59e0b;
            --c-red: #ef4444;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --shadow-card: 0 20px 60px -20px rgba(0, 0, 0, 0.65);
            --shadow-btn: 0 6px 20px -6px rgba(99, 102, 241, 0.55);
            --t-fast: 0.15s ease;
            --t-base: 0.25s ease;
            --t-slow: 0.4s ease;
            --board-frame-1: #4a2f1e;
            --board-frame-2: #2a1810;
            --board-light: #e8d4a8;
            --board-light-2: #dcc398;
            --board-dark: #8b5a2b;
            --board-dark-2: #7a4a20;
            --board-coord: rgba(232, 212, 168, 0.9);
            --board-coord-edge: #fbbf24;
        }

        [data-theme="light"] {
            --bg-color: #eef2ff;
            --bg-gradient-1: #e0e7ff;
            --bg-gradient-2: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.88);
            --card-border: rgba(15, 23, 42, 0.08);
            --card-glow: rgba(99, 102, 241, 0.15);
            --text-color: #0f172a;
            --text-muted: #475569;
            --text-subtle: #64748b;
            --border-color: rgba(15, 23, 42, 0.1);
            --border-strong: rgba(15, 23, 42, 0.25);
            --input-bg: rgba(255, 255, 255, 0.95);
            --shadow-card: 0 20px 60px -20px rgba(30, 41, 59, 0.28);
            --board-frame-1: #5a3a22;
            --board-frame-2: #3a2418;
            --board-light: #f0e0c0;
            --board-light-2: #e6d0a8;
            --board-dark: #a06a3a;
            --board-dark-2: #8b5a2b;
            --board-coord: rgba(240, 224, 192, 0.95);
            --board-coord-edge: #fbbf24;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at 20% 0%, var(--bg-gradient-1) 0%, var(--bg-gradient-2) 55%);
            background-attachment: fixed;
            color: var(--text-color);
            margin: 0;
            padding: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            min-height: 100dvh;
            transition: background-color var(--t-slow), color var(--t-base);
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
        }

        body::before, body::after {
            content: "";
            position: fixed;
            border-radius: 50%;
            filter: blur(130px);
            opacity: 0.3;
            z-index: -1;
            pointer-events: none;
        }
        body::before { width: 420px; height: 420px; background: #6366f1; top: -140px; left: -120px; }
        body::after { width: 460px; height: 460px; background: #8b5cf6; bottom: -180px; right: -140px; }

        .container {
            position: relative;
            background: var(--card-bg);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            padding: 20px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card), 0 0 0 1px var(--card-border) inset;
            width: 100%;
            max-width: 520px;
            text-align: center;
            border: 1px solid var(--card-border);
            animation: cardIn 0.55s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
            transition: max-width var(--t-base), padding var(--t-base);
        }

        @keyframes cardIn {
            from { opacity: 0; transform: translateY(16px) scale(0.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* === MODO TELA CHEIA === */
        body.is-fullscreen { padding: 0; }
        body.is-fullscreen .container {
            max-width: 100vw;
            width: 100vw;
            border-radius: 0;
            padding: 10px;
            animation: none;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        body.is-fullscreen #lobby-screen { max-width: 520px; margin: 0 auto; width: 100%; }
        body.is-fullscreen #game-screen {
            max-width: min(100vw, calc(100dvh - 20px));
            margin: 0 auto;
            width: 100%;
        }
        body.is-fullscreen #btn-fullscreen { display: none; }

        .fs-exit-btn {
            position: fixed;
            top: 12px; right: 12px; z-index: 5000; display: none;
            width: 40px; height: 40px; padding: 0; border-radius: 50%;
            background: rgba(15, 23, 42, 0.9) !important;
            border: 1px solid rgba(148, 163, 184, 0.3) !important;
            color: #f8fafc !important; font-size: 18px; cursor: pointer;
            align-items: center; justify-content: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
        }
        body.is-fullscreen .fs-exit-btn { display: flex; }

        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 8px; flex-wrap: wrap; }
        .btn-small {
            width: auto; margin: 0; padding: 8px 14px; border-radius: 999px;
            font-size: 13px; font-weight: 600; background: var(--input-bg);
            border: 1px solid var(--border-color); color: var(--text-muted);
            cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
        }
        .btn-small:hover { color: var(--text-color); border-color: var(--border-strong); background: var(--card-bg); }

        .lobby-box {
            background: var(--input-bg); border: 1px solid var(--border-color);
            border-radius: var(--radius-md); padding: 16px; margin-bottom: 12px; text-align: left;
        }
        .lobby-box h3 { margin-top: 0; font-size: 15px; color: var(--c-blue); display: flex; align-items: center; gap: 6px; }
        .lobby-box p { font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px; line-height: 1.4; }

        .user-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 10px; background: var(--input-bg); padding: 8px 12px;
            border-radius: var(--radius-md); border: 1px solid var(--border-color);
        }
        .user-info-left { display: flex; align-items: center; gap: 8px; }
        .user-avatar-display {
            display: inline-flex; align-items: center; justify-content: center;
            width: 32px; height: 32px; font-size: 16px; border-radius: 50%;
            background: linear-gradient(135deg, rgba(99,102,241,0.25), rgba(139,92,246,0.2));
            border: 1px solid rgba(99, 102, 241, 0.4);
        }
        #display-nome { font-size: 13.5px; font-weight: 700; }

        .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-left: 6px; background: var(--text-subtle); }
        .status-dot.online { background: var(--c-green); box-shadow: 0 0 8px var(--c-green); }
        .status-dot.offline { background: var(--c-red); }

        .match-info-bar {
            display: flex; justify-content: space-between; align-items: center;
            background: var(--input-bg); padding: 8px 12px; border-radius: var(--radius-md);
            margin-bottom: 10px; font-size: 12px; border: 1px solid var(--border-color); font-weight: 600; gap: 8px;
            flex-wrap: wrap;
        }
        #turno-status { color: var(--c-amber); }

        .board-wrapper {
            position: relative;
            width: 100%;
            max-width: min(100%, calc(100dvh - 280px));
            aspect-ratio: 1 / 1;
            padding: 22px;
            background: linear-gradient(145deg, var(--board-frame-1) 0%, var(--board-frame-2) 100%);
            border-radius: 12px; box-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.75);
            margin: 0 auto 12px; user-select: none;
        }

        /* === REGRAS / COORDENADAS DO TABULEIRO === */
        .board-ruler {
            position: absolute; font-family: 'JetBrains Mono', monospace;
            font-size: 11px; font-weight: 700; color: var(--board-coord);
            pointer-events: none; z-index: 2;
        }
        .board-ruler-top { top: 0; left: 22px; right: 22px; height: 22px; display: grid; grid-template-columns: repeat(8, 1fr); align-items: center; }
        .board-ruler-bottom { bottom: 0; left: 22px; right: 22px; height: 22px; display: grid; grid-template-columns: repeat(8, 1fr); align-items: center; }
        .board-ruler-left { top: 22px; bottom: 22px; left: 0; width: 22px; display: grid; grid-template-rows: repeat(8, 1fr); align-items: center; }
        .board-ruler-right { top: 22px; bottom: 22px; right: 0; width: 22px; display: grid; grid-template-rows: repeat(8, 1fr); align-items: center; }
        .board-ruler .coord {
            display: flex; align-items: center; justify-content: center;
            width: 100%; height: 100%;
            text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9);
            letter-spacing: 0.5px;
        }
        .board-ruler .coord.edge { font-weight: 800; color: var(--board-coord-edge); }

        .checkers-grid {
            display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr);
            width: 100%; height: 100%; border-radius: 4px; overflow: hidden;
            box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.45), 0 4px 14px rgba(0, 0, 0, 0.55);
        }

        .square { display: flex; align-items: center; justify-content: center; position: relative; cursor: pointer; }
        .square.light { background-color: var(--board-light); }
        .square.dark { background-color: var(--board-dark); }
        .square.selected { box-shadow: inset 0 0 0 3px rgba(99, 102, 241, 0.95) !important; }
        .square.highlight { box-shadow: inset 0 0 0 3px rgba(74, 222, 128, 0.95) !important; }
        .square.capture-target { box-shadow: inset 0 0 0 3px rgba(239, 68, 68, 0.95) !important; }

        .piece {
            width: 80%; height: 80%; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700; position: relative;
        }
        .piece.white { background: radial-gradient(circle at 32% 28%, #ffffff 0%, #cdb896 75%, #a08768 100%); border: 1px solid #7a6350; }
        .piece.red { background: radial-gradient(circle at 32% 28%, #dc2626 0%, #6b0f0f 80%, #450808 100%); border: 1px solid #2d0606; }
        .piece.king::after { content: "♛"; font-size: 17px; position: absolute; color: #fbbf24; font-weight: 900; }

        .piece-wrapper { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
        .piece-wrapper.movel { animation: pulse-movel 1.5s infinite; }
        @keyframes pulse-movel { 0% { transform: scale(1); } 50% { transform: scale(1.055); } 100% { transform: scale(1); } }

        .instructions { font-size: 12px; color: var(--text-muted); margin: 4px 0 10px; min-height: 18px; }

        button, input {
            width: 100%; padding: 10px 12px; border: 1px solid var(--border-color);
            border-radius: var(--radius-md); font-size: 13.5px; font-family: inherit; font-weight: 600;
            background: var(--input-bg); color: var(--text-color); cursor: pointer;
        }
        button { border: none; color: #fff; background: linear-gradient(135deg, var(--btn-primary), var(--btn-accent)); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-whatsapp { background: linear-gradient(135deg, #16a34a, #22c55e); display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 6px; }

        .hidden { display: none !important; }

        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center;
            z-index: 1000; padding: 20px; opacity: 0; pointer-events: none; transition: opacity 0.25s;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-card { background: var(--card-bg); border-radius: var(--radius-lg); padding: 24px; max-width: 380px; width: 100%; text-align: center; }
        .modal-actions { display: flex; gap: 8px; margin-top: 15px; }
        .modal-actions button { flex: 1; }

        .toast-container { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1100; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
        .toast { background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--c-blue); padding: 10px 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 600; color: var(--text-color); }
        .toast.success { border-left-color: var(--c-green); }
        .toast.error { border-left-color: var(--c-red); }

        /* === RESPONSIVO: OCUPAÇÃO MÁXIMA NO CELULAR === */
        @media (max-width: 600px) {
            body { padding: 6px; align-items: flex-start; }
            .container { padding: 12px; max-width: 100vw; border-radius: 16px; }
            .board-wrapper { max-width: 100%; padding: 20px; border-radius: 10px; }
            .board-ruler { font-size: 10px; }
            .board-ruler-top, .board-ruler-bottom { left: 20px; right: 20px; height: 20px; }
            .board-ruler-left, .board-ruler-right { top: 20px; bottom: 20px; width: 20px; }
            .top-bar { margin-bottom: 8px; }
            .user-header { padding: 6px 10px; margin-bottom: 8px; }
            .match-info-bar { padding: 6px 10px; font-size: 11.5px; margin-bottom: 8px; }
            .instructions { font-size: 11.5px; margin: 4px 0 8px; }
            .piece.king::after { font-size: 14px; }
        }

        @media (max-width: 380px) {
            .board-ruler { font-size: 9px; }
            .board-ruler-top, .board-ruler-bottom { left: 18px; right: 18px; height: 18px; }
            .board-ruler-left, .board-ruler-right { top: 18px; bottom: 18px; width: 18px; }
            .board-wrapper { padding: 18px; }
        }

        @media (max-height: 500px) and (orientation: landscape) {
            body { padding: 4px; }
            .container { padding: 8px; max-width: 100vw; }
            .board-wrapper { max-width: min(100%, calc(100dvh - 120px)); }
            .user-header, .match-info-bar { display: none; }
        }
    </style>
</head>
<body>

    <button class="fs-exit-btn" id="fs-exit" type="button">✕</button>

    <div class="container" id="main-container">
        <div class="top-bar">
            <button id="btn-sair" class="btn-small" type="button">🚪 Sair</button>
            <div style="display:flex; gap:6px;">
                <button id="btn-google" class="btn-small" type="button">🌐 Google</button>
                <button id="btn-som" class="btn-small" type="button" title="Ativar/Desativar som">🔊</button>
                <button id="btn-fullscreen" class="btn-small" type="button">⛶</button>
                <button id="theme-toggle" class="btn-small" type="button">🌙</button>
            </div>
        </div>

        <!-- LOBBY -->
        <div id="lobby-screen">
            <div class="user-header" style="justify-content: center;">
                <div class="user-info-left">
                    <span id="lobby-avatar" class="user-avatar-display">⏳</span>
                    <strong id="lobby-nome">A carregar…</strong>
                </div>
            </div>

            <div class="lobby-box">
                <h3>♟️ Jogo de Damas Multiplayer</h3>
                <p>Jogue uma partida clássica de Damas 8x8 em tempo real. Crie a sua sala e envie o link pelo WhatsApp!</p>
                <button id="btn-criar-sala" type="button" disabled>🚀 Criar Sala de Damas</button>
            </div>

            <div class="lobby-box" style="margin-bottom: 0;">
                <h3>🔗 Entrar com Código</h3>
                <div style="display: flex; gap: 6px;">
                    <input type="text" id="input-codigo-sala" placeholder="Ex: DAMAS-7812" style="font-family: monospace;">
                    <button id="btn-entrar-sala" type="button" style="width: 120px;" disabled>Entrar</button>
                </div>
            </div>
        </div>

        <!-- TELA DO JOGO -->
        <div id="game-screen" class="hidden">
            <div class="user-header">
                <div class="user-info-left">
                    <span id="display-avatar" class="user-avatar-display">😀</span>
                    <strong id="display-nome"></strong>
                    <span id="oponente-status" class="status-dot"></span>
                </div>
                <span id="display-sala-tag" style="font-size: 11px; color: var(--c-blue);">Sala</span>
            </div>

            <div class="match-info-bar">
                <span>Sua Peça: <strong id="info-minha-cor" style="color: var(--c-blue);">--</strong></span>
                <span id="turno-status">Aguardando...</span>
                <div style="display:flex; gap:6px;">
                    <button id="btn-desistir" class="btn-small" type="button" style="padding: 4px 10px; font-size: 11px;">🏳️ Desistir</button>
                    <button id="btn-fullscreen-game" class="btn-small" type="button" style="padding: 4px 10px; font-size: 11px;">⛶</button>
                </div>
            </div>

            <p class="instructions" id="info-instrucao">Toque em sua peça e depois na casa de destino válida.</p>

            <div class="board-wrapper">
                <div class="board-ruler board-ruler-top" id="labels-top"></div>
                <div class="board-ruler board-ruler-bottom" id="labels-bottom"></div>
                <div class="board-ruler board-ruler-left" id="labels-left"></div>
                <div class="board-ruler board-ruler-right" id="labels-right"></div>
                <div class="checkers-grid" id="checkers-board"></div>
            </div>

            <!-- Barra pós-jogo -->
            <div id="div-pos-jogo" class="hidden" style="display:flex; gap:8px; margin-top:8px;">
                <button id="btn-jogar-novamente" type="button" style="flex:1; background: linear-gradient(135deg, #16a34a, #22c55e);">🔄 Jogar Novamente</button>
                <button id="btn-sair-pos-jogo" type="button" style="flex:1;">🚪 Sair</button>
            </div>

            <!-- Pedido de revanche pendente -->
            <div id="div-revanche-pendente" class="hidden" style="margin-top:8px; padding:10px 12px; background: var(--input-bg); border:1px solid var(--border-color); border-radius: var(--radius-md); font-size:13px; text-align:center;">
                <span id="revanche-msg">Aguardando resposta...</span>
                <div id="revanche-actions" style="display:none; gap:8px; margin-top:8px;">
                    <button id="btn-aceitar-revanche" type="button" style="flex:1; background: linear-gradient(135deg, #16a34a, #22c55e); padding:8px 12px; font-size:13px;">✅ Aceitar</button>
                    <button id="btn-recusar-revanche" type="button" style="flex:1; padding:8px 12px; font-size:13px;">❌ Recusar</button>
                </div>
            </div>

            <div id="div-whatsapp" class="hidden">
                <button id="btn-whatsapp" class="btn-whatsapp" type="button">💬 Convidar Colega pelo WhatsApp</button>
            </div>
        </div>
    </div>

    <!-- MODAL -->
    <div class="modal-overlay" id="modal-overlay">
        <div class="modal-card">
            <div style="font-size: 40px; margin-bottom: 10px;" id="modal-icon">ℹ️</div>
            <h2 id="modal-title" style="margin: 0 0 10px; font-size: 18px;">Título</h2>
            <p id="modal-message" style="color: var(--text-muted); font-size: 13.5px; margin-bottom: 15px; white-space: pre-line;"></p>
            <div class="modal-actions" id="modal-actions"></div>
        </div>
    </div>

    <div class="toast-container" id="toast-container"></div>

    <script type="module">
        import { db, auth } from "./firebase-config.js";
        import {
            ref, get, set, update, onValue, runTransaction, onDisconnect, serverTimestamp
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";
        import {
            signInAnonymously,
            onAuthStateChanged,
            GoogleAuthProvider,
            signInWithPopup
        } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

        let jogadorSessao = null;
        let idSalaAtual = null;
        let minhaCor = null;
        let tabuleiro = [];
        let celulaSelecionada = null;
        let movimentosValidos = [];
        let turnoAtual = 'white';
        let jogoEncerrado = false;
        let unsubscribeFirebase = null;
        let oponenteConectado = false;
        let capturaMultiplaEmAndamento = false;
        let salaConfirmada = false;

        // Estados pós-jogo
        let vencedorDeclarado = null;
        let pedidoRevancheDe = null;
        let revancheAceita = false;
        let desistenciaProcessada = false;

        // ============================================================
        // ============== SISTEMA DE SOM (Web Audio API) ==============
        // ============================================================
        const SoundFX = (() => {
            let ctx = null;
            let ativo = true;

            function init() {
                if (!ctx) {
                    try {
                        ctx = new (window.AudioContext || window.webkitAudioContext)();
                    } catch (e) { ativo = false; }
                }
                if (ctx && ctx.state === 'suspended') ctx.resume().catch(() => {});
            }

            function beep({ freq = 440, type = 'sine', duration = 0.12, gain = 0.15, sweepTo = null, delay = 0 }) {
                if (!ativo) return;
                init();
                if (!ctx) return;
                const now = ctx.currentTime + delay;
                const osc = ctx.createOscillator();
                const g = ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, now);
                if (sweepTo) osc.frequency.exponentialRampToValueAtTime(sweepTo, now + duration);
                g.gain.setValueAtTime(0.0001, now);
                g.gain.exponentialRampToValueAtTime(gain, now + 0.01);
                g.gain.exponentialRampToValueAtTime(0.0001, now + duration);
                osc.connect(g); g.connect(ctx.destination);
                osc.start(now); osc.stop(now + duration + 0.02);
            }

            return {
                get ativo() { return ativo; },
                toggle() { ativo = !ativo; if (ativo) { init(); this.click(); } return ativo; },
                click() { beep({ freq: 600, type: 'triangle', duration: 0.05, gain: 0.06 }); },
                select() { beep({ freq: 880, type: 'sine', duration: 0.08, gain: 0.08 }); },
                move() {
                    beep({ freq: 320, type: 'triangle', duration: 0.08, gain: 0.10 });
                    beep({ freq: 480, type: 'sine', duration: 0.10, gain: 0.08, delay: 0.05 });
                },
                capture() {
                    beep({ freq: 220, type: 'sawtooth', duration: 0.10, gain: 0.10 });
                    beep({ freq: 160, type: 'square', duration: 0.14, gain: 0.08, delay: 0.08 });
                },
                king() {
                    beep({ freq: 523, type: 'sine', duration: 0.10, gain: 0.10 });
                    beep({ freq: 659, type: 'sine', duration: 0.10, gain: 0.10, delay: 0.10 });
                    beep({ freq: 784, type: 'sine', duration: 0.16, gain: 0.12, delay: 0.20 });
                },
                win() {
                    const notas = [523, 659, 784, 1046];
                    notas.forEach((f, i) => beep({ freq: f, type: 'sine', duration: 0.18, gain: 0.12, delay: i * 0.13 }));
                },
                lose() {
                    const notas = [440, 392, 330, 262];
                    notas.forEach((f, i) => beep({ freq: f, type: 'triangle', duration: 0.20, gain: 0.11, delay: i * 0.15 }));
                },
                notify() {
                    beep({ freq: 740, type: 'sine', duration: 0.09, gain: 0.09 });
                    beep({ freq: 880, type: 'sine', duration: 0.11, gain: 0.09, delay: 0.09 });
